# انسخ هذا الملف إلى .env.local واملأ القيم — لا تضع أسراراً في المستودع

# ---- جلسات وحماية ----
AUTH_SECRET=ضع_سلسلة_عشوائية_طويلة_هنا
# فعّلها على 1 عند النشر على دومين HTTPS فقط
# COOKIE_SECURE=1

# ---- حساب الأدمن الأول (يُنشأ عند أول تشغيل) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=غيّرها_فوراً

# ---- Google (اجتماعات Meet + استضافة الملفات على Drive) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# اتركه فارغاً ليُشتق من عنوان التشغيل، أو ثبّته لدومين الإنتاج
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/google/callback

# ---- YouTube (اختياري: لجلب كل فيديوهات القناة) ----
YOUTUBE_API_KEY=

# ---- Firebase Realtime Database (قاعدة البيانات) ----
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
FIREBASE_CLIENT_EMAIL=
# سطر واحد مع 

FIREBASE_PRIVATE_KEY=""

# ---- إشعارات الأجهزة (Web Push) ----
# ولّدها بـ: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- النسخ الاحتياطي المجدول (فيرسل) ----
CRON_SECRET=سلسلة_عشوائية

# ---- تعدّد المنصّات (Multi-Tenant) ----
# النطاق الجذري: كل منصّة تُخدم على {slug}.ROOT_DOMAIN — اتركه فارغاً محلّياً
# (محلّياً تعمل {slug}.localhost:3000 تلقائياً، أو ?tenant=slug على localhost)
ROOT_DOMAIN=
# معرّف المنصّة الحالية بعد الترحيل (node scripts/migrate-to-tenants.mjs) — الافتراضي default
DEFAULT_TENANT_ID=default
# الـslug الخاص بها إن اختلف عن المعرّف
# DEFAULT_TENANT_SLUG=
# ماذا يخدم الجذر (ROOT_DOMAIN بلا نطاق فرعي)؟ tenant = المنصّة الافتراضية (الوضع الحالي) · hub = المنصّة الأم
ROOT_HOST_MODE=tenant

# ---- لوحة المنصّات (Hub / Super Admin) ----
# حساب أدمن المنصّات الأوّل — يُنشأ عند أوّل محاولة دخول على /hub
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# 0 يرفع قفل الجهاز عن أدمن المنصّات (صمّام استعادة إن فُقد الجهاز)
SUPER_DEVICE_LOCK=1
# سرّ توقيع جلسة لوحة المنصّات — منفصل عن AUTH_SECRET؛ إن تُرك اشتُقّ منه
HUB_SESSION_SECRET=
